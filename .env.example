# Public base URL used to build device image links and API base URLs.
# Production MUST replace this with the public HTTPS domain.
# Leave unset to keep the local placeholder default (http://127.0.0.1:8080).
PUBLIC_BASE_URL=https://api.example.com

# Comma-separated list of trusted browser origins allowed to issue
# state-changing dashboard requests (CSRF protection). Defaults to the
# same origin derived from PUBLIC_BASE_URL when unset. Only add extra origins
# (e.g. a separate admin SPA host) when you actually serve the dashboard there.
ALLOWED_ORIGINS=https://api.example.com

NEW_API_BASE_URL=http://new-api:3000

# Data directory holding the SQLite database and generated images.
# Defaults to ./data relative to the working directory. The database lives at
# BTF_DATA_DIR/btf-device-gateway.sqlite3.
BTF_DATA_DIR=./data

# Dedicated HMAC secret used to sign short-lived /device-images/... URLs.
# Optional: when unset, a stable per-installation key is generated and stored
# (mode 0600) inside BTF_DATA_DIR. Set explicitly when running multiple replicas
# so signed image links are accepted by every instance.
BTF_IMAGE_URL_SIGNING_KEY=
# Lifetime of a signed image URL, in seconds (minimum 60).
BTF_IMAGE_URL_TTL_SECONDS=86400

# Internal New API relay token (server-side only, never shared with clients).
# Required in production: run the `doctor` check to verify it is set.
NEW_API_TOKEN=replace-with-internal-new-api-token

# Payment callback base URL. It must be publicly reachable over HTTPS.
PAYMENT_NOTIFY_URL=https://api.example.com

# Enable only in a non-production environment.
DEMO_PAYMENT_ENABLED=false
MOCK_PAYMENT_SECRET=replace-with-random-mock-secret

# WeChat Pay API v3
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_PLATFORM_SERIAL_NO=
WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
WECHAT_API_BASE_URL=https://api.mch.weixin.qq.com

# Alipay RSA2
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# Observability / callback protection.
# Log level for the btf_device_gateway logger (DEBUG/INFO/WARNING/ERROR).
BTF_LOG_LEVEL=INFO
# Process-local payment callback throttle (callbacks per client per 60s window).
BTF_PAYMENT_NOTIFY_RATE_LIMIT=60
# Maximum accepted payment callback body size in bytes.
BTF_PAYMENT_NOTIFY_MAX_BODY_BYTES=262144

# Usage cost estimation (per unit, in the configured currency). Optional:
# leave unset/blank to keep the safe default of 0 (cost estimation disabled).
# BTF_CHAT_PROMPT_COST_PER_MILLION: cost per 1,000,000 prompt tokens.
# BTF_CHAT_COMPLETION_COST_PER_MILLION: cost per 1,000,000 completion tokens.
# BTF_IMAGE_COST_PER_REQUEST: flat cost per generated image request.
BTF_CHAT_PROMPT_COST_PER_MILLION=0
BTF_CHAT_COMPLETION_COST_PER_MILLION=0
BTF_IMAGE_COST_PER_REQUEST=0

# Lifetime of a pending payment order, in seconds. Defaults to 86400 (24h) and
# is capped at a ~100 year window so a typo cannot mint an unbounded value.
BTF_ORDER_EXPIRES_SECONDS=86400
