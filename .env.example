# Public base URL used to build device image links and API base URLs.
# Production MUST replace this with the public HTTPS domain.
# Leave unset to keep the local placeholder default (http://127.0.0.1:8080).
PUBLIC_BASE_URL=https://api.example.com
NEW_API_BASE_URL=http://new-api:3000

# Dedicated HMAC secret used to sign short-lived /device-images/... URLs.
# Optional: when unset, a stable per-installation key is generated and stored
# (mode 0600) inside BTF_DATA_DIR. Set explicitly when running multiple replicas
# so signed image links are accepted by every instance.
BTF_IMAGE_URL_SIGNING_KEY=
# Lifetime of a signed image URL, in seconds (minimum 60).
BTF_IMAGE_URL_TTL_SECONDS=86400

# Internal New API relay token (server-side only, never shared with clients).
# Required in production: run the `doctor` check to verify it is set.
NEW_API_TOKEN=replace-with-internal-new-api-token

# Payment callback base URL. It must be publicly reachable over HTTPS.
PAYMENT_NOTIFY_URL=https://api.example.com

# Enable only in a non-production environment.
DEMO_PAYMENT_ENABLED=false
MOCK_PAYMENT_SECRET=replace-with-random-mock-secret

# WeChat Pay API v3
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_PLATFORM_SERIAL_NO=
WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
WECHAT_API_V3_KEY=
WECHAT_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
WECHAT_API_BASE_URL=https://api.mch.weixin.qq.com

# Alipay RSA2
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
